# ── outfit-api ───────────────────────────────────────────────────────────────
# Copia este archivo a `outfit-api/.env` para desarrollo local.
# En Railway estas mismas variables se definen en el dashboard del servicio.
# `.env` ya esta cubierto por el .gitignore de la raiz (el patron `.env` no
# lleva slash, asi que aplica a cualquier profundidad) — nunca se commitea.

# OBLIGATORIA. El unico secreto que el juego de Roblox necesita enviarnos,
# via el header `x-api-key`. Sin ella el servicio arranca igual (para que el
# healthcheck de Railway no entre en crash-loop) pero rechaza con 401 toda
# ruta /v1. Genera una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTFIT_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# Railway inyecta PORT automaticamente. En local, 3100 por defecto para no
# chocar con el 3000 de la API existente.
# PORT=3100

# error | warn | info | debug
# LOG_LEVEL=info

# ── TTLs de cache (milisegundos) ──────────────────────────────────────────────
# TTL_USERNAME_MS=43200000        # 12 h  — username -> userId
# TTL_OUTFIT_LIST_MS=300000       # 5 min — listado de outfits de un usuario
# TTL_OUTFIT_DETAILS_MS=3600000   # 1 h   — detalles de un outfit
# TTL_ASSET_BUNDLES_MS=86400000   # 24 h  — a que bundle pertenece un asset
#                                 #         (dato estructural del catalogo;
#                                 #          global, no por jugador)
# TTL_CATALOG_DETAILS_MS=3600000  # 1 h   — ficha de catalogo por asset
#                                 #         (limitado / fuera de venta)
# TTL_NEGATIVE_MS=300000          # 5 min — cache negativa (404)

# Tope de assets a los que se resuelve el bundle en una peticion con
# ?bundles=1. Un outfit real no pasa de ~20 assets.
# MAX_BUNDLE_LOOKUPS_PER_REQUEST=24

# Tamaño del lote a catalog/items/details con ?catalog=1. Un outfit entero
# siempre cabe en un unico lote.
# MAX_CATALOG_BATCH_SIZE=100

# ── Limite de nuestra propia API, por IP ──────────────────────────────────────
# Un servidor de Roblox = una IP con MUCHOS jugadores detras. Por eso el
# default es alto: esto es un guardia anti-abuso, no un limitador por jugador.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000

# ── Llamadas salientes a Roblox ───────────────────────────────────────────────
# UPSTREAM_TIMEOUT_MS=6000
# UPSTREAM_MAX_CONCURRENT=3
# UPSTREAM_MAX_QUEUE=200
# UPSTREAM_MAX_RETRIES=2

# ── Cache en memoria ──────────────────────────────────────────────────────────
# CACHE_MAX_ENTRIES=50000

# Reservado para el futuro driver de Redis. Hoy solo se acepta "memory".
# CACHE_DRIVER=memory
