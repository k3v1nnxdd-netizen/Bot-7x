# ── outfit-api ───────────────────────────────────────────────────────────────
# Copia este archivo a `outfit-api/.env` para desarrollo local.
# En Railway estas mismas variables se definen en el dashboard del servicio.
# `.env` ya esta cubierto por el .gitignore de la raiz (el patron `.env` no
# lleva slash, asi que aplica a cualquier profundidad) — nunca se commitea.

# OBLIGATORIA. El unico secreto que el juego de Roblox necesita enviarnos,
# via el header `x-api-key`. Sin ella el servicio arranca igual (para que el
# healthcheck de Railway no entre en crash-loop) pero rechaza con 401 toda
# ruta /v1. Genera una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTFIT_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# SEGUNDO secreto, para las rutas /admin (whitelist de grupos con licencia).
# Viaja en su propia cabecera, `x-admin-key`.
#
# TIENE QUE SER DISTINTA DE LA ANTERIOR. OUTFIT_API_KEY vive dentro de un
# script de Roblox distribuido a servidores que no controlamos, asi que hay
# que darla por filtrable; si fuera la misma, cualquiera que la extrajera
# podria autorizarse a si mismo. El servicio avisa por consola si coinciden.
#
# Si no la defines, el servicio arranca igual y la API de outfits funciona con
# normalidad, pero /admin responde 503 admin_disabled. Generala aparte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=otro-secreto-largo-y-aleatorio-DISTINTO-del-anterior

# TERCER secreto, exclusivo del plugin privado de Roblox Studio ("7x Outfit
# Importer"). Viaja en su propia cabecera, `x-plugin-key`, y solo abre las
# rutas /plugin.
#
# TIENE QUE SER DISTINTA DE LAS OTRAS DOS. Son tres publicos distintos y cada
# uno tiene que poder revocarse por separado: el plugin vive instalado en
# Studio, la key del juego vive dentro del .rbxl que se vende, y la de admin
# solo la manejamos nosotros. Si el plugin compartiera clave con el juego,
# filtrarse una copia del .rbxl abriria tambien la busqueda; si la compartiera
# con /admin, un plugin perdido daria control sobre las licencias. El servicio
# avisa por consola si coinciden.
#
# Si no la defines, el servicio arranca igual y todo lo demas funciona con
# normalidad, pero POST /plugin/outfits/search responde 503 plugin_disabled
# (APAGADA, no abierta). Generala aparte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLUGIN_API_KEY=un-tercer-secreto-largo-y-aleatorio-SOLO-para-el-plugin

# ── Postgres (sistema de licencias) ──────────────────────────────────────────
# En Railway NO se escribe a mano: se enlaza el servicio con la base y Railway
# inyecta DATABASE_URL sola (usa la referencia ${{Postgres.DATABASE_URL}}, que
# apunta a la red privada del proyecto). En local, pega aqui la URL PUBLICA de
# tu base — nunca la subas al repositorio, este archivo es solo el ejemplo.
#
# Si falta, el servicio arranca igual y la API de outfits funciona con
# normalidad; lo unico que queda inactivo es la base (whitelist de grupos).
# DATABASE_URL=postgresql://usuario:password@host:5432/railway

# auto | disable | no-verify | verify
# `auto` (default) acierta solo en Railway: sin TLS contra la red privada
# (*.railway.internal) y TLS sin verificar certificado contra el proxy publico
# (*.proxy.rlwy.net), que usa uno autofirmado. Solo toca esto si usas un
# Postgres propio con certificado de una CA real (-> verify).
# DATABASE_SSL=auto

# DB_POOL_MAX=5                   # conexiones por instancia (el plan de Railway
#                                 #   trae pocas y varias instancias las comparten)
# DB_CONNECTION_TIMEOUT_MS=8000   # espera maxima por una conexion libre
# DB_IDLE_TIMEOUT_MS=30000        # cierre de conexiones ociosas
# DB_STATEMENT_TIMEOUT_MS=10000   # corte del lado del servidor por consulta
# DB_SCHEMA_MAX_RETRIES=4         # intentos de crear el esquema al arrancar

# Railway inyecta PORT automaticamente. En local, 3100 por defecto para no
# chocar con el 3000 de la API existente.
# PORT=3100

# error | warn | info | debug
# LOG_LEVEL=info

# ── TTLs de cache (milisegundos) ──────────────────────────────────────────────
# TTL_USERNAME_MS=43200000        # 12 h  — username -> userId
# TTL_OUTFIT_LIST_MS=300000       # 5 min — listado de outfits de un usuario
# TTL_OUTFIT_DETAILS_MS=3600000   # 1 h   — detalles de un outfit
# TTL_ASSET_BUNDLES_MS=86400000   # 24 h  — a que bundle pertenece un asset
#                                 #         (dato estructural del catalogo;
#                                 #          global, no por jugador)
# TTL_CATALOG_DETAILS_MS=3600000  # 1 h   — ficha de catalogo por asset
#                                 #         (limitado / fuera de venta)
# TTL_NEGATIVE_MS=300000          # 5 min — cache negativa (404)

# De quien es una experiencia de Roblox, para /v1/license/verify. 6 h porque un
# juego no cambia de dueño casi nunca. Ademas de ahorrar dos llamadas a Roblox
# por servidor que arranca, es lo que mantiene la verificacion en pie cuando
# Roblox tiene un mal rato.
# TTL_GAME_OWNERSHIP_MS=21600000

# Composicion de un bundle (que assets lo forman) para /v1/catalog/batch. Es un
# dato estructural: no cambia una vez publicado. El PRECIO del bundle va por
# separado con el TTL de catalogo (1 h), que si se mueve.
# TTL_BUNDLE_DETAILS_MS=86400000

# Tope de assets a los que se resuelve el bundle en una peticion con
# ?bundles=1. Un outfit real no pasa de ~20 assets.
# MAX_BUNDLE_LOOKUPS_PER_REQUEST=24

# Tamaño del lote a catalog/items/details. 120 es el TOPE REAL del endpoint
# (comprobado: 121 -> 400 "Invalid count") y se usa entero porque la cuota de
# Roblox se gasta POR LLAMADA, no por item: dejar huecos libres en cada lote es
# tirar cuota sin recibir nada a cambio.
# MAX_CATALOG_BATCH_SIZE=120

# ── Limite de nuestra propia API, por IP ──────────────────────────────────────
# Un servidor de Roblox = una IP con MUCHOS jugadores detras. Por eso el
# default es alto: esto es un guardia anti-abuso, no un limitador por jugador.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000

# ── Llamadas salientes a Roblox ───────────────────────────────────────────────
# UPSTREAM_TIMEOUT_MS=6000
# UPSTREAM_MAX_CONCURRENT=3
# UPSTREAM_MAX_QUEUE=200
# UPSTREAM_MAX_RETRIES=2

# Marcapasos adaptativo (AIMD) por ruta: separacion minima entre dos llamadas de
# la MISMA ruta de Roblox. Es el unico mecanismo PREVENTIVO de los cuatro — los
# otros tres (cooldown, breaker, gate) reaccionan a un limite que ya nos comimos.
#
# ARRANCA EN CERO: mientras Roblox no se queje no hay separacion ninguna y el
# trafico del juego se comporta igual que siempre. Solo aparece cuando Roblox
# señala presion (un 429, o un x-ratelimit-remaining: 0 en una respuesta buena) y
# se relaja sola conforme las llamadas vuelven a salir bien.
#
# Existe por la busqueda del plugin, que es lo unico que hace rafagas
# sostenidas: sin el, doce olas seguidas agotan la ventana de cuota del catalogo
# tan deprisa como la red lo permita.
# UPSTREAM_PACER_BASE_MS=120     # separacion al activarse
# UPSTREAM_PACER_MAX_MS=2000     # techo de la separacion
# UPSTREAM_PACER_MIN_MS=25       # por debajo, se apaga del todo
# UPSTREAM_PACER_DECAY=0.9       # cuanto se relaja por llamada correcta

# Aprendizaje de cabeceras. Cuando Roblox publica x-ratelimit-limit/-remaining/
# -reset, la cuota que queda se REPARTE a lo largo de lo que queda de ventana
# (separacion = ventana restante / llamadas restantes) en vez de gastarse tan
# deprisa como la red permita. Es lo que evita el burst inicial: el AIMD
# reacciona a la presion, y para cuando reacciona una ola entera puede haberse
# comido la ventana. Solo por debajo de esta fraccion de cuota restante; no se
# inventa ninguna cuota que Roblox no haya publicado.
# UPSTREAM_PACER_HEADER_FRACTION=0.5

# Concurrencia efectiva POR RUTA (por debajo del gate global). El avatar va a
# 2: una ola con tres en vuelo dispara tres peticiones antes de que la primera
# respuesta haya enseñado nada de la cuota; con dos, la primera respuesta llega
# — y con ella sus cabeceras — antes de que la tercera salga.
# UPSTREAM_ROUTE_CONCURRENCY_USER_AVATAR=2
# UPSTREAM_ROUTE_CONCURRENCY_CATALOG_DETAILS=2

# 429 SIN cabecera de espera. Roblox no dijo cuanto esperar: se espera
# BASTANTE y se dobla con cada 429 seguido (5, 10, 20, 40 s, hasta el techo), y
# NO se reintenta en linea. Antes habia un backoff de 150-3000 ms con
# reintentos: tres SONDEOS contra una ruta recien cerrada, cada uno gastando
# cuota y renovando el limite. No es una cuota inventada: es cuanto se espera
# cuando Roblox no dice nada.
# UPSTREAM_RATE_LIMIT_FALLBACK_BASE_MS=5000
# UPSTREAM_RATE_LIMIT_FALLBACK_MAX_MS=60000

# El ritmo SOSTENIBLE aprendido de las cabeceras (ventana / cuota) se aplica
# como suelo del marcapasos desde que se conoce, y el AIMD nunca relaja por
# debajo de el mientras la cuota se conozca. Es lo que evita gastar la ventana
# de golpe incluso la primera vez.

# ── Cache en memoria ──────────────────────────────────────────────────────────
# CACHE_MAX_ENTRIES=50000

# Reservado para el futuro driver de Redis. Hoy solo se acepta "memory".
# CACHE_DRIVER=memory

# ── Limites de POST /v1/catalog/batch ────────────────────────────────────────
# Un outfit real ronda los 20 assets. Estos topes dejan 3x de margen y a la vez
# garantizan que una peticion nuestra nunca se parta en dos lotes de Roblox:
# items/details admite 120 items (comprobado: 121 -> 400 Invalid count).
# CATALOG_BATCH_MAX_ASSETS=64
# CATALOG_BATCH_MAX_BUNDLES=32
# CATALOG_BATCH_MAX_TOTAL=80

# Busquedas inversas asset -> bundle por peticion. Es el UNICO endpoint de
# Roblox sin lote (una llamada por asset), asi que este es el tope que de
# verdad protege la cuota. Solo se gasta en tipos que pueden venir en un bundle
# (partes del cuerpo, Dynamic Heads, Mood): 1-3 en un outfit tipico.
# CATALOG_BATCH_MAX_REVERSE_LOOKUPS=8

# ── Busqueda de outfits del plugin de Studio (POST /plugin/outfits/search) ────
# `amount` son outfits VALIDOS, no intentos: un candidato que no encaja no gasta
# plaza, se sustituye por el siguiente de la comunidad. De ahi que haya DOS
# presupuestos de candidatos y no uno, que era el bug:
#
#   DESEADO     lo que se ESPERA necesitar, recalculado en cada vuelta con la
#               tasa de aceptacion real y la EWMA historica del grupo. Dimensiona
#               y estima; NO termina la busqueda. Que un grupo salga caro sube el
#               numero, no corta el recorrido.
#   TECHO DURO  proteccion anti-bucle. Dimensionado para NO alcanzarse en una
#               busqueda sana: lo normal es terminar por `amount` alcanzado, por
#               vuelta completa a la comunidad, por limite real de Roblox o por
#               presupuesto de tiempo.
#
# Con un solo numero, `min(600, max(60, amount * 4))` daba 60 para amount=10 y
# ese 60 era a la vez el suelo del muestreo y el techo de la busqueda: en una
# comunidad con un 3% de aceptacion salian 2 outfits de 10 y paraba, sin haber
# pasado de la primera pagina de miembros.

# Presupuesto DESEADO (adaptativo)
# PLUGIN_SEARCH_CANDIDATES_PER_RESULT=4          # coste asumido sin evidencia ninguna
# PLUGIN_SEARCH_MIN_CANDIDATES=60                # suelo: muestra minima con sentido
# PLUGIN_SEARCH_CANDIDATE_MARGIN=1.5             # margen sobre el coste estimado
# PLUGIN_SEARCH_MAX_CANDIDATES_PER_RESULT=120    # techo de la ESTIMACION de coste
# PLUGIN_SEARCH_CANDIDATE_FULL_WEIGHT_SAMPLE=100 # muestra a partir de la cual lo vivo pesa 1

# TECHO DURO de candidatos (anti-bucle). Es clamp(amount * 150, 1500, 25000), y
# por tanto la tolerancia por resultado NO es constante — el 150 solo manda en
# el tramo proporcional:
#
#     amount     techo    candidatos/resultado
#          1     1 500          1 500   <- suelo
#         10     1 500            150   <- suelo, justo al ras
#        100    15 000            150   <- proporcional
#        500    25 000             50   <- techo absoluto
#
# El valor que de verdad se aplica se publica en stats como
# `effectiveHardCandidatesPerResult`. El techo absoluto baja la tolerancia en
# pedidos grandes a proposito: 25.000 candidatos son 25.000 llamadas de avatar
# (la unica etapa sin lote), y subirlo cargaria la cuota de Roblox del servicio
# entero por un caso que el presupuesto de tiempo cortaria igualmente antes.
#
# Alcanzar el techo NO significa que en la comunidad no haya outfits en el rango
# pedido: significa que no conseguimos encontrar los suficientes dentro de
# nuestros limites seguros. La rotacion continua donde quedo, asi que reintentar
# mira gente nueva y puede dar mas.
# PLUGIN_SEARCH_HARD_CANDIDATES_PER_RESULT=150
# PLUGIN_SEARCH_MIN_HARD_CANDIDATES=1500
# PLUGIN_SEARCH_MAX_CANDIDATES=25000             # techo absoluto, pase lo que pase
# PLUGIN_SEARCH_HARD_CANDIDATE_LIMIT=            # override en caliente; vacio = calculado

# Paginas de miembros (100 por pagina). El limite normal sale del techo de
# candidatos; esto solo cubre el caso patologico de un grupo que sirve paginas
# indefinidamente sin traer a nadie nuevo — ahi los candidatos no crecen y su
# techo no cortaria jamas. Con los defaults: 10 -> 25 paginas, 500 -> 260.
# PLUGIN_SEARCH_MAX_MEMBER_PAGES=400
# PLUGIN_SEARCH_MEMBER_PAGE_SLACK=10

# Presupuesto de TRABAJO (maxWorking). Es una PROTECCION EXTREMA, no el
# terminador normal: una busqueda de 10 tiene que poder recorrer cientos de
# candidatos malos al ritmo que Roblox deje. Escala con `amount`:
# 10 -> 10 min, 100 -> 55 min, 500 -> 60 min. Las pausas por limite de Roblox
# NO lo consumen; el ritmo al que Roblox deja preguntar SI (al ritmo sostenible
# del avatar, ~1 llamada/s, 300 candidatos son cinco minutos). El reloj arranca
# cuando arranca la BUSQUEDA, no al aceptar la peticion. Agotarlo devuelve lo
# encontrado, nunca un error.
# PLUGIN_SEARCH_TIME_BUDGET_MS=                  # override explicito; vacio = calculado
# PLUGIN_SEARCH_TIME_BUDGET_BASE_MS=300000
# PLUGIN_SEARCH_TIME_BUDGET_PER_RESULT_MS=30000
# PLUGIN_SEARCH_TIME_BUDGET_MIN_MS=600000
# PLUGIN_SEARCH_TIME_BUDGET_MAX_MS=3600000
# PLUGIN_SEARCH_TIME_BUDGET_SYNC_CEILING_MS=25000 # en sincrono hay un socket abierto

# ── Park / resume ante un limite de Roblox ───────────────────────────────────
# Un cooldown de Roblox es una INSTRUCCION DE ESPERAR, no un "no hay outfits".
# Cuando una ruta pide esperar, el trabajo se ESTACIONA: persiste su checkpoint
# (outfits, pendientes, contadores, resumeAt), mantiene el grupo reservado
# renovando el lease, no manda NI UNA peticion a Roblox, y reanuda al llegar
# resumeAt donde estaba. Si la instancia muere estacionada, otra la adopta al
# arrancar y sigue desde el checkpoint, con el mismo searchId. Puede atravesar
# varios cooldowns: es lo normal con una cuota estrecha, no una anomalia.
#
# El presupuesto de espera es INDEPENDIENTE del de trabajo. Lo que acota el
# total es el reloj de pared (maxWallClock = trabajo + espera), publicado en
# stats como wallClockBudgetMs; alcanzarlo es la proteccion EXTREMA, y solo
# entonces se devuelve partial con avatarRateLimit / catalogRateLimit.
#
# PROTECCION EXTREMA, no terminador normal. Quince minutos de espera acumulada
# son del orden de treinta cooldowns de 25-30 s (los Retry-After reales del
# avatar). NO hay contador de pausas: lo hubo (ocho) y fue la causa directa de
# un 2 de 10 — pausas cortas encadenadas por 429 sin cabecera lo agotaban en
# veinte segundos. Una pausa individual nunca termina una busqueda; solo el
# reloj de pared.
# PLUGIN_SEARCH_RATE_LIMIT_WAIT_BUDGET_MS=900000 # espera total por busqueda (15 min)
#   (suelo de 5 min: un valor menor se ignora con aviso; era el terminador normal)
# NO hay techo por pausa: PLUGIN_SEARCH_RATE_LIMIT_SINGLE_WAIT_MS se ignora si
# sigue definida. Una pausa, por larga que sea, cambia la fase del trabajo y se
# espera; solo el reloj de pared global termina una busqueda asincrona.
# PLUGIN_SEARCH_RATE_LIMIT_WAIT_MARGIN_MS=500    # no volver antes de tiempo
# PLUGIN_SEARCH_RATE_LIMIT_HEARTBEAT_MS=5000     # latido del trabajo estacionado

# ── Propiedad de los trabajos entre instancias (park/resume durable) ─────────
# Cada trabajo vivo LATE por su cuenta cada heartbeatIntervalMs, haga lo que
# haga (trabajar, esperar turno, estar estacionado). Otra instancia solo lo
# ADOPTA si su dueño lleva adoptAfterMs sin latir, o si lo solto al apagarse
# (SIGTERM del redeploy). La relacion entre los dos es la tolerancia a fallos
# transitorios de Postgres: con 5 s y 90 s hacen falta dieciocho latidos
# fallidos seguidos para que un trabajo vivo parezca muerto.
#
# El fallo que esto corrige: la creacion no se esperaba, la primera escritura
# vallada del ejecutor podia llegar antes que el INSERT, y "cero filas" se
# leia como "otra instancia lo adopto" — el proceso soltaba una busqueda que
# nadie tenia y el trabajo se quedaba en 0 de 10 para siempre.
# PLUGIN_JOB_HEARTBEAT_INTERVAL_MS=5000
# PLUGIN_JOB_ADOPT_AFTER_MS=90000
# PLUGIN_JOB_RECOVERY_INTERVAL_MS=15000    # cada cuanto se adopta lo soltado/huerfano
# PLUGIN_JOB_RELEASED_EXPIRE_MS=3600000    # soltado y sin adoptar en 1 h -> expired

# ── Regla de accesorios ──────────────────────────────────────────────────────
# Un outfit candidato lleva MAS DE TRES accesorios reales (sombreros,
# accesorios clasicos, ropa por capas, cejas/pestañas). Partes del cuerpo,
# cabezas, caras, ropa clasica, gear, animaciones, emotes y humores NO cuentan.
# Se decide con la respuesta del avatar en la mano, ANTES de gastar catalogo:
# stats.rejectedTooFewAccessories cuenta cuantos se saltaron asi. 0 apaga la
# regla.
# PLUGIN_SEARCH_MIN_ACCESSORIES=4

# PLUGIN_SEARCH_CONCURRENCY=4             # candidatos evaluados en paralelo

# TTLs de las dos entidades nuevas que usa esa busqueda.
# TTL_GROUP_MEMBERS_MS=600000     # 10 min — pagina de miembros de un grupo
# TTL_USER_AVATAR_MS=600000       # 10 min — avatar ACTUAL de un usuario
